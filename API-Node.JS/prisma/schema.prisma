generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SexoTipo {
  macho
  hembra
}


model usuarios {
  id               Int        @id @default(autoincrement())
  nombre           String     @db.VarChar(100)
  email            String?    @unique @db.VarChar(100)
  hash_contrasenia String
  mascotas         mascotas[]
}

model Mascota {
  id         Int     @id @default(autoincrement())
  nombre     String
  sexo       SexoTipo
  usuarioId  Int
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
  especieId  Int
  especie    Especie @relation(fields: [especieId], references: [id])
  razaId     Int
  raza       Raza    @relation(fields: [razaId], references: [id])
}

model Especie {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  razas     Raza[]
  mascotas  Mascota[]
}

model Raza {
  id                     Int         @id @default(autoincrement())
  nombre                 String
  especieId              Int
  especie                Especie     @relation(fields: [especieId], references: [id])
  mascotas               Mascota[]
  temperaturaNormalMin   Float?
  temperaturaNormalMax   Float?
  pulsacionesNormalesMin Int?
  pulsacionesNormalesMax Int?
}