generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuario {
  id               Int        @id @default(autoincrement())
  nombre           String     @db.VarChar(100)
  email            String?    @unique @db.VarChar(100)
  hash_contrasenia String
  imagen_url       String?
  mascotas         mascota[]
}

enum Sexo {
  MACHO
  HEMBRA
}

model mascota {
  id                   Int       @id @default(autoincrement())
  nombre               String    @unique @db.VarChar(100)
  id_user              Int
  id_raza              Int?
  id_especie           Int?
  pulsaciones          Int?
  estado               String?   @db.VarChar(50)
  latitud              Decimal?  @db.Decimal(10, 8)
  longitud             Decimal?  @db.Decimal(11, 8)
  ultima_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  sexo                 Sexo?
  especie              especie? @relation(fields: [id_especie], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_especie")
  raza                 raza?    @relation(fields: [id_raza], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_raza")
  usuario              usuario  @relation(fields: [id_user], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model especie {
  id       Int        @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(50)
  mascotas mascota[]
  razas    raza[]
}

model raza {
  id         Int        @id @default(autoincrement())
  nombre     String     @db.VarChar(100)
  id_especie Int
  mascotas   mascota[]
  especie    especie   @relation(fields: [id_especie], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
